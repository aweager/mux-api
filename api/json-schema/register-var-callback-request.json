{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://mux-api.local/schemas/register-var-callback-request.json",
  "title": "RegisterVarCallback Request",
  "description": "Request parameters for MuxAPI.RegisterVarCallback method",
  "type": "object",
  "required": ["parent_location", "namespace", "callback"],
  "properties": {
    "parent_location": {
      "$ref": "common.json#/definitions/Location"
    },
    "namespace": {
      "$ref": "common.json#/definitions/Namespace"
    },
    "callback": {
      "type": "string",
      "description": "The jrpc-mesh routable address of the callback method to invoke when resolved variable values change, in the format 'host/service/Method'",
      "examples": ["client.host/client.service/CallbackMethod"]
    }
  }
}
